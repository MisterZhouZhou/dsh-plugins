{
  "name": "dsh-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Web Plugin Collection — community-driven aggregation ecosystem for DeepSeek Harness Web GUI plugins. Each plugin is an independent Cordis bundle, distributed via npm and the Workshop.",
  "scripts": {
    "build": "pnpm -r build",
    "dev:watch": "node scripts/dev-watch.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "aggregate:check": "node scripts/aggregate.mjs --check",
    "plugin:new": "node scripts/dsh-plugin-new",
    "sync-shared": "node scripts/sync-shared.mjs",
    "sync-shared:check": "node scripts/sync-shared.mjs --check",
    "test:scripts": "node --test scripts/*.test.mjs",
    "pr:review": "node scripts/pr-review.mjs",
    "docs:check": "node scripts/verify-docs.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-util-crypto": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-util-time": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@playwright/test": "^1.62.1",
    "lightningcss": "^1.32.0",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.2"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.24.0"
}